DEPLOY_ENV=staging
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml:compose.staging.yaml

WEB_HOST=register-staging.example.org
API_HOST=register-staging-api.example.org
AUTH_HOST=register-staging-auth.example.org
MAIL_HOST=register-staging-mail.example.org

APP_IMAGE=bloomper/spexregister-server:develop
WEB_IMAGE=bloomper/spexregister-web:develop
KEYCLOAK_IMAGE=bloomper/fgv-keycloak:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_APP_DATABASE=spexregister
MYSQL_APP_USER=spexregister
MYSQL_KEYCLOAK_DATABASE=keycloak
MYSQL_KEYCLOAK_USER=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
KEYCLOAK_THEME=FGV

APP_KEYCLOAK_REALM=fgv
APP_KEYCLOAK_ADMIN_CLIENT_ID=fgv-admin
APP_KEYCLOAK_CLIENT_CLIENT_ID=spexregister
APP_SEED_AUDIT_DATA=true
APP_IMPORT_SAMPLE_DATA=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
