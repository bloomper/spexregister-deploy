DEPLOY_ENV=staging
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml:compose.staging.yaml

WEB_NAME="Spexregister (staging)"
WEB_HOST=register-staging.example.org
API_HOST=register-staging-api.example.org
AUTH_HOST=register-staging-auth.example.org
MAIL_HOST=register-staging-mail.example.org

API_IMAGE=bloomper/spexregister-server:develop
WEB_IMAGE=bloomper/spexregister-web:develop
AUTH_IMAGE=bloomper/fgv-keycloak:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_API_DATABASE=spexregister
MYSQL_API_USER=spexregister
MYSQL_AUTH_DATABASE=keycloak
MYSQL_AUTH_USER=keycloak

AUTH_ADMIN=admin
AUTH_ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
AUTH_THEME=FGV
TURNSTILE_SITE_KEY=

API_AUTH_REALM=fgv
API_AUTH_ADMIN_CLIENT_ID=fgv-admin
API_AUTH_CLIENT_CLIENT_ID=spexregister
API_SEED_AUDIT_DATA=true
API_IMPORT_SAMPLE_DATA=true

SMTP_HOST=mail
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
