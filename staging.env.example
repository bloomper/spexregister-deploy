DEPLOY_ENV=staging
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

WEB_HOST=register-staging.example.org
API_HOST=register-api-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/spexregister-server:develop
WEB_IMAGE=bloomper/spexregister-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=spexregister
MYSQL_USER=spexregister

ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org

API_SEED_AUDIT_DATA=true
API_IMPORT_SAMPLE_DATA=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv

UMAMI_WEBSITE_ID=
