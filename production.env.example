DEPLOY_ENV=production
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

WEB_NAME=Spexregister
WEB_HOST=register.example.org
API_HOST=register-api.example.org
AUTH_HOST=register-auth.example.org

API_IMAGE=bloomper/spexregister-server:2.0.0
WEB_IMAGE=bloomper/spexregister-web:2.0.0
AUTH_IMAGE=bloomper/fgv-keycloak:1.0.0
MYSQL_IMAGE=mysql:8.4
CLOUDFLARED_VERSION=2026.10.0

MYSQL_API_DATABASE=spexregister
MYSQL_API_USER=spexregister
MYSQL_AUTH_DATABASE=keycloak
MYSQL_AUTH_USER=keycloak

AUTH_ADMIN=admin
AUTH_ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
AUTH_THEME=FGV
TURNSTILE_SITE_KEY=

API_AUTH_REALM=fgv
API_AUTH_ADMIN_CLIENT_ID=fgv-admin
API_AUTH_CLIENT_CLIENT_ID=spexregister
API_SEED_AUDIT_DATA=false
API_IMPORT_SAMPLE_DATA=false

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
