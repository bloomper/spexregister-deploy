DEPLOY_ENV=production
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

WEB_NAME=Spexregister
WEB_HOST=register.example.org
API_HOST=register-api.example.org
AUTH_HOST=register-auth.example.org

APP_IMAGE=bloomper/spexregister-server:2.0.0
WEB_IMAGE=bloomper/spexregister-web:2.0.0
KEYCLOAK_IMAGE=bloomper/fgv-keycloak:1.0.0
MYSQL_IMAGE=mysql:8.4
CLOUDFLARED_VERSION=2026.10.0

MYSQL_APP_DATABASE=spexregister
MYSQL_APP_USER=spexregister
MYSQL_KEYCLOAK_DATABASE=keycloak
MYSQL_KEYCLOAK_USER=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
KEYCLOAK_THEME=FGV
TURNSTILE_SITE_KEY=

APP_KEYCLOAK_REALM=fgv
APP_KEYCLOAK_ADMIN_CLIENT_ID=fgv-admin
APP_KEYCLOAK_CLIENT_CLIENT_ID=spexregister
APP_SEED_AUDIT_DATA=false
APP_IMPORT_SAMPLE_DATA=false

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
