DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

WEB_HOST=register.example.org
API_HOST=register-api.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/spexregister-server:2.0.0
WEB_IMAGE=bloomper/spexregister-web:2.0.0
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=spexregister
MYSQL_USER=spexregister

ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org

API_SEED_AUDIT_DATA=false
API_IMPORT_SAMPLE_DATA=false

API_GEOCODING_ENABLED=true
API_GEOCODING_EMAIL=admin@example.org

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

FGV_REVIVAL_WEB_URL=https://revival.example.org
SPEXIFY_WEB_URL=https://spexify.example.org
SPEXFLIX_WEB_URL=https://spexflix.example.org
SPEXGRAM_WEB_URL=https://spexgram.example.org
ARCHIVE_WEB_URL=https://archive.example.org

SUPPORT_EMAIL=support.register@example.org
FEEDBACK_EMAIL=feedback.register@example.org
SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv

UMAMI_WEBSITE_ID=
